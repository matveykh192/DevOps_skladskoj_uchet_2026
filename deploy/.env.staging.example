# пример настроек окружения для staging (лр6)
# реальный файл .env.staging не попадает в git и в docker-образ

# порт публикации на хосте
STAGING_PORT=8080

# параметры базы данных staging
WAREHOUSE_DB_USER=warehouse_staging_user
WAREHOUSE_DB_PASSWORD=staging_secure_password_2026
WAREHOUSE_DB_NAME=warehouse_staging_db

# секретный ключ для jwt и сессий
WAREHOUSE_SECRET_KEY=staging-demo-secret-key-change-me

# образ из registry и тег релиза
REGISTRY_IMAGE=ghcr.io/matveykh192/devops_skladskoj_uchet_2026
IMAGE_TAG=latest
APP_ENV=staging
